# Database
DATABASE_URL=postgresql+asyncpg://supersoul:supersoul@localhost:5432/supersoul

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Agora RTC (App Certificate never goes to the frontend)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora Chat (from Console → Project → Chat → Config)
AGORA_CHAT_APP_KEY=
AGORA_CHAT_REST_HOST=

# Frontend (copy NEXT_PUBLIC_* into frontend/.env.local for `npm run dev`)
# Hybrid local: http://localhost:8000
# Full docker compose (via Nginx): http://localhost/api
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_PUBLIC_AGORA_CHAT_APP_KEY=
