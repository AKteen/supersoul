# Database. Local and Docker Compose use asyncpg.
# Render's connection string may be postgres://...?sslmode=require — the API rewrites that.
DATABASE_URL=postgresql+asyncpg://supersoul:supersoul@localhost:5432/supersoul

# Redis. Render Key Value may be redis:// or rediss://.
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Comma-separated. Production: the Vercel site origin, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# Agora RTC (App Certificate stays on the API only)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora Chat (Console → Project → Chat). Quote the app key because # starts a comment.
AGORA_CHAT_APP_KEY=
AGORA_CHAT_REST_HOST=

# Frontend build (Vercel project env, and frontend/.env.local for local dev).
# Local API: http://localhost:8000
# Docker Compose via Nginx: http://localhost/api
# Production: https://<render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_PUBLIC_AGORA_CHAT_APP_KEY=
