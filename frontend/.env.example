# Frontend only. Copy to frontend/.env.local for local runs.
# On Vercel, set these in the project before the build. Do not commit .env.local.

# Local API: http://localhost:8000
# Docker Compose via Nginx: http://localhost/api
# Production: https://<render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGORA_APP_ID=
# Quote the app key because # starts a comment.
NEXT_PUBLIC_AGORA_CHAT_APP_KEY=
